<div id="loginOptionsContainer" style="display: none;">
    <div id="loginOptionsContent">
        <div class="loginOptionsMainContent">
            <img class="vortexLoginLogo" src="assets/images/vortex-login-logo.png" alt="Vortex">
            <h2>Bienvenido a Vortex</h2>
            <p class="vortexLoginSubtitle">Tu próxima aventura comienza aquí</p>
            <div class="loginOptionActions">
                <div class="loginOptionButtonContainer">
                    <button id="loginOptionMicrosoft" class="loginOptionButton">
                        <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 23 23" aria-hidden="true">
                            <path fill="#f35325" d="M1 1h10v10H1z"/><path fill="#81bc06" d="M12 1h10v10H12z"/><path fill="#05a6f0" d="M1 12h10v10H1z"/><path fill="#ffba08" d="M12 12h10v10H12z"/>
                        </svg>
                        <span>Iniciar sesión con Microsoft</span>
                    </button>
                </div>
                <button id="loginOptionMojang" hidden>Iniciar sesión con Mojang</button>
            </div>
            <p class="vortexLoginHint">Usa tu cuenta de Minecraft para continuar</p>
            <div class="vortexLoginFooter"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M14 3h7v7M21 3 11 13M10 5H4v15h15v-6"/></svg><span>La sesión se abrirá en tu navegador</span></div>
            <div id="loginOptionCancelContainer" style="display: none;"><button id="loginOptionCancelButton">Volver</button></div>
        </div>
    </div>
    <script src="./assets/js/scripts/loginOptions.js"></script>
</div>
