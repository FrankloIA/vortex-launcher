{
  "name": "vortex-launcher",
  "version": "1.0.1",
  "description": "Launcher personalizado para Minecraft con sincronizacion centralizada via GitHub",
  "main": "src/main/main.js",
  "author": "Vortex",
  "license": "MIT",
  "scripts": {
    "start": "npm --prefix vortex start",
    "dev": "npm --prefix vortex start",
    "test:vortex": "npm --prefix vortex test",
    "admin": "node vortex/tools/admin-server.cjs",
    "build": "npm --prefix vortex run dist:win -- --publish never",
    "build:win": "npm --prefix vortex run dist:win -- --publish never",
    "build:linux": "electron-builder --linux",
    "build:mac": "electron-builder --mac",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "adm-zip": "^0.5.10",
    "electron-updater": "^6.3.4",
    "minecraft-launcher-core": "^3.18.1",
    "node-fetch": "^2.7.0",
    "semver": "^7.6.3"
  },
  "devDependencies": {
    "electron": "^31.3.1",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.vortex.launcher",
    "productName": "Vortex Launcher",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico"
    },
    "linux": {
      "target": "AppImage",
      "icon": "assets/icon.png"
    },
    "mac": {
      "target": "dmg",
      "icon": "assets/icon.icns"
    },
    "publish": {
      "provider": "github",
      "owner": "FrankloIA",
      "repo": "vortex-launcher"
    }
  },
  "allowScripts": {
    "electron@31.7.7": true
  }
}
